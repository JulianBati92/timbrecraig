PORT=3000
HOME_ID=casa

# URL pública donde está desplegado TimbreCraig, sin barra final.
# Ejemplo: https://timbrecraig.onrender.com
PUBLIC_BASE_URL=

# Trello - canal principal de notificaciones
# Crear una API key/token de Trello y obtener el ID de la lista donde se crearán las tarjetas.
TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_LIST_ID=

# Telegram opcional como segundo canal
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Webhook opcional (n8n, Make, backend propio, etc.)
NOTIFICATION_WEBHOOK_URL=

# Cloudflare Turnstile opcional. Si se define SECRET, el backend exige token válido.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
