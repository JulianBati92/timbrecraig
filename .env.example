PORT=3000
HOME_ID=casa

# URL pública donde está desplegado TimbreCraig, sin barra final.
# En Vercel puede dejarse vacío: el backend detecta el host automáticamente.
PUBLIC_BASE_URL=

# ntfy - canal de notificaciones al celular
# Usá un topic largo y aleatorio. El mismo topic se configura en la app ntfy del celular.
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=

# Opcional. Sólo hace falta si más adelante usás un servidor/topic protegido con autenticación.
NTFY_TOKEN=

# Cloudflare Turnstile opcional.
# No definir TURNSTILE_SECRET_KEY hasta integrar el widget en el frontend.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
